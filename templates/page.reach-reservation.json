        "q2": {
          "type": "question",
          "settings": {
            "question": "What is the deposit for?",
            "answer": "Your deposit unlocks exclusive VIP pricing, priority free shipping, and early-backer rewards. It also helps us plan production more accurately based on real demand."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Is the deposit refundable?",
            "answer": "Absolutely. If you change your mind, just contact us at hello@motion-rivalry.com and we'll issue a full refund — no questions asked."
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How will the deposit be applied during the Kickstarter campaign?",
            "answer": "After you complete your Kickstarter pledge using the same email as your deposit, we'll issue a partial refund once the campaign ends. This refund includes your deposit amount plus your extra VIP savings within 14 business days after the campaign ends."
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Will I be notified when the Kickstarter campaign launches?",
            "answer": "Yes. You'll receive email reminders a few days before and on the day the campaign launches, so you won't miss your early access window."
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What if I use a different email on Kickstarter?",
            "answer": "The email you use for your Kickstarter pledge must match the one you used for your deposit to ensure your discount and refund are correctly applied. If you need to update your email, contact us with your deposit confirmation and we'll assist you."
