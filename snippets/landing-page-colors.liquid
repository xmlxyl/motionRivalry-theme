{%- comment -%}
  Map landing CSS variables from the section color scheme class.
  Parent element must include: color-{{ section.settings.color_scheme }} gradient
  Usage: {% render 'landing-page-colors', section: section %}
{%- endcomment -%}
{%- liquid
  assign section_scheme_id = section.settings.color_scheme | default: 'scheme-landing'
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .landing-page.color-{{ section_scheme_id }} {
    --landing-bg-primary: rgb(var(--color-background));
    --landing-bg-secondary: rgb(var(--color-background));
    --landing-bg-card: rgb(var(--color-shadow));
    --landing-bg-surface: rgb(var(--color-shadow));
    --landing-accent-primary: rgb(var(--color-button));
    --landing-accent-secondary: rgb(var(--color-link));
    --landing-accent-label: rgb(var(--color-button-text));
    --landing-text-heading: rgb(var(--color-foreground));
    --landing-text-body: rgb(var(--color-link));
    --landing-text-subtitle: rgb(var(--color-subtitle));
    --landing-text-muted: rgba(var(--color-subtitle), 0.85);
    --landing-border: rgba(var(--color-foreground), 0.18);
    --landing-section-bg: rgb(var(--color-background));
  }
{%- endstyle -%}
