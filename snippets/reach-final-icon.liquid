{%- liquid
  assign icon_size = size | default: 'md'
  if icon_size == 'sm'
    assign dim = 14
  else
    assign dim = 20
  endif
-%}
{%- case icon -%}
  {%- when 'kickstarter' -%}
    <svg class="reach-final-icon reach-final-icon--kickstarter" xmlns="http://www.w3.org/2000/svg" width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="#05CE78" aria-hidden="true">
      <path d="M7.168 0c-3.2 0-5.797 2.579-5.797 5.758v12.484C1.371 21.42 3.968 24 7.168 24c1.981 0 3.716-.978 4.768-2.479l.794.79c2.26 2.245 5.943 2.245 8.203 0a5.724 5.724 0 001.696-4.075 5.724 5.724 0 00-1.696-4.074l-2.182-2.168 2.182-2.156a5.724 5.724 0 001.696-4.074 5.724 5.724 0 00-1.696-4.074c-2.26-2.246-5.942-2.246-8.203 0l-.794.789A5.797 5.797 0 007.168 0Z"/>
    </svg>
  {%- when 'facebook' -%}
    <svg class="reach-final-icon reach-final-icon--facebook" xmlns="http://www.w3.org/2000/svg" width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="#0866FF" aria-hidden="true">
      <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
    </svg>
{%- endcase -%}
