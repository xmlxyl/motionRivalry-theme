{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-order-journey.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors' %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="order-journey landing-page section-{{ section.id }}-padding" id="order-journey">
  <div class="page-width">
    <div class="order-journey__header">
      <span class="order-journey__line"></span>
      <h2 class="order-journey__title">{{ section.settings.heading }}</h2>
      <span class="order-journey__line"></span>
    </div>

    <div class="order-journey__timeline">
      <div class="order-journey__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'phase' -%}
            <div class="order-journey__dot{% if block.settings.active %} is-active{% endif %}" {{ block.shopify_attributes }}>
              <span>{{ forloop.index }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="order-journey__phases">
      {%- for block in section.blocks -%}
        {%- if block.type == 'phase' -%}
          <div class="order-journey__phase{% if block.settings.active %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.active and block.settings.badge != blank -%}
              <span class="landing-page__badge order-journey__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            <span class="order-journey__phase-number">Phase {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3 class="order-journey__phase-title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="order-journey__phase-desc">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.steps != blank -%}
              <div class="order-journey__next-steps">
                <p class="order-journey__next-label">Next Steps</p>
                <ul class="order-journey__step-list">
                  {%- assign steps = block.settings.steps | newline_to_br | split: '<br />' -%}
                  {%- for step in steps -%}
                    {%- if step != blank -%}
                      <li>{{ step | strip_html | strip }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="order-journey__info-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'info' -%}
            <div class="order-journey__info" {{ block.shopify_attributes }}>
              <span class="order-journey__info-icon">
                {%- case block.settings.icon -%}
                  {%- when 'email' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 6h15v10H1zM16 10h4l3 4v2h-7V10z" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="6" cy="18" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                  {%- when 'calendar' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M3 10h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                {%- endcase -%}
              </span>
              <p class="order-journey__info-text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Order Journey",
  "tag": "section",
  "class": "section-order-journey",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pre-Order Phase"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "steps",
          "label": "Next steps (one per line)"
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "Mark as active phase",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Active badge",
          "default": "Active Now"
        }
      ]
    },
    {
      "type": "info",
      "name": "Info block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "shield", "label": "Shield" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "We'll email you when the campaign launches"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Pre-Order Journey"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Order Journey",
      "blocks": [
        {
          "type": "phase",
          "settings": {
            "title": "Pre-Order Phase",
            "description": "Reserve your trainer with a $50 deposit today.",
            "steps": "Pay $50 deposit on our store\nReceive confirmation email\nGet notified before Kickstarter launch",
            "active": true,
            "badge": "Active Now"
          }
        },
        {
          "type": "phase",
          "settings": {
            "title": "Kickstarter Launch",
            "description": "Complete your pledge on Kickstarter to lock in early-bird pricing."
          }
        },
        {
          "type": "phase",
          "settings": {
            "title": "After Campaign Ends",
            "description": "Get your deposit refunded and receive your product when ready to ship."
          }
        },
        {
          "type": "info",
          "settings": { "icon": "email", "text": "We'll email you when the campaign launches" }
        },
        {
          "type": "info",
          "settings": { "icon": "shipping", "text": "Ships worldwide with tracked delivery" }
        },
        {
          "type": "info",
          "settings": { "icon": "shield", "text": "100% refundable deposit, no risk" }
        },
        {
          "type": "info",
          "settings": { "icon": "calendar", "text": "Estimated delivery Q4 2026" }
        }
      ]
    }
  ]
}
{% endschema %}
