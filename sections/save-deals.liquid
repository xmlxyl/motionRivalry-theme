{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-save-deals.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors', section: section %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="save-deals landing-page color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" id="save-deals">
  <div class="page-width">
    <div class="save-deals__card" data-aos="fade-up">
      <div class="save-deals__grid">
        <div class="save-deals__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="landing-page__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="landing-page__heading save-deals__heading">{{ section.settings.heading | newline_to_br }}</h2>
          {%- endif -%}

          <ul class="landing-page__check-list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="landing-page__check-icon">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="save-deals__graphic">
          <div class="save-deals__equation">
            <div class="save-deals__box save-deals__box--deposit">
              <span class="save-deals__box-label">{{ section.settings.deposit_label }}</span>
              <span class="save-deals__box-value save-deals__box-value--deposit">{{ section.settings.deposit_value }}</span>
            </div>
            <div class="save-deals__equals" aria-hidden="true">=</div>
            <div class="save-deals__box save-deals__box--save">
              <span class="save-deals__box-label">{{ section.settings.save_label }}</span>
              <span class="save-deals__box-value save-deals__box-value--save">{{ section.settings.save_value }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Save Deals",
  "tag": "section",
  "class": "section-save-deals",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pre-order at Kickstarter launch"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-landing"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reserve Early, Save Big."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Pay a $50 Deposit Now\nSave up to $2100"
    },
    {
      "type": "header",
      "content": "Deal graphic"
    },
    {
      "type": "text",
      "id": "deposit_label",
      "label": "Deposit label",
      "default": "DEPOSIT"
    },
    {
      "type": "text",
      "id": "deposit_value",
      "label": "Deposit value",
      "default": "$50"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Save label",
      "default": "YOU SAVE UP TO"
    },
    {
      "type": "text",
      "id": "save_value",
      "label": "Save value",
      "default": "$2100"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Save Deals",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Pre-order at Kickstarter launch" } },
        { "type": "benefit", "settings": { "text": "Deposit paid = 100% refundable" } },
        { "type": "benefit", "settings": { "text": "Partial refund issued after Kickstarter concludes" } }
      ]
    }
  ]
}
{% endschema %}
