{{ 'reach-reservation.css' | asset_url | stylesheet_tag }}
{% render 'reach-fonts' %}
{% render 'reach-padding', section: section %}

<section class="reach-page reach-page__section section-{{ section.id }}-padding">
  {% render 'reach-side-tag', text: section.settings.side_tag, side: 'right' %}

  <div class="reach-page__inner" style="padding-top:6rem;padding-bottom:6rem;">
    <p class="reach-page__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="reach-page__heading">{{ section.settings.heading | newline_to_br }}</h2>
    <p class="reach-page__text" style="margin-top:1.5rem;max-width:48rem;">{{ section.settings.description }}</p>

    <div class="reach-vision__media" style="margin-top:3rem;">
      {% render 'reach-media', image: section.settings.video_poster, video_url: section.settings.video_url, label: section.settings.video_label, ratio: 'video' %}
    </div>

    <div class="reach-vision-cards">
      {%- for block in section.blocks -%}
        <article class="reach-vision-card" {{ block.shopify_attributes }}>
          <span class="reach-vision-card__icon">
            {% render 'reach-vision-icon', icon: block.settings.icon %}
          </span>
          <p class="reach-vision-card__tag">{{ block.settings.tag }}</p>
          <h3 class="reach-vision-card__title">{{ block.settings.title }}</h3>
          <p class="reach-vision-card__body">{{ block.settings.body }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REACH AI Vision",
  "tag": "section",
  "class": "section-reach-ai-vision",
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "map-pin", "label": "Map pin" },
            { "value": "compass", "label": "Compass" },
            { "value": "shield-check", "label": "Shield check" }
          ],
          "default": "map-pin"
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "10 Hz GPS" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sub-Second Positioning You Can Trust" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "side_tag", "label": "Side tag", "default": "[ A tech company in sports ]" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "[ Precision sensor suite ]" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Race-grade data,\non every terrain." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "One sports computer. Four disciplines. Zero compromise on accuracy." },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Multi-sport montage" },
    { "type": "image_picker", "id": "video_poster", "label": "Video poster image" },
    { "type": "url", "id": "video_url", "label": "Video URL" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [
    {
      "name": "REACH AI Vision",
      "blocks": [
        { "type": "card", "settings": { "icon": "map-pin", "tag": "10 Hz GPS", "title": "Sub-Second Positioning You Can Trust", "body": "10 Hz multi-band GPS with GPS · BeiDou · GLONASS support locks your position ten times every second." } },
        { "type": "card", "settings": { "icon": "compass", "tag": "9-Axis IMU", "title": "Motion Tuned for Every Discipline", "body": "Accelerometer, gyroscope, magnetometer and a 0.1 m barometer fuse into discipline-specific models." } },
        { "type": "card", "settings": { "icon": "shield-check", "tag": "IPX7 · Sunlight Readable", "title": "Built for Rain, Spray & Altitude", "body": "A 3.5\" full-lamination Blanview color display stays readable in direct sun." } }
      ]
    }
  ]
}
{% endschema %}
