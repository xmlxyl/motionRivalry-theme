{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product-v2.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors', section: section %}

{%- liquid
  assign section_scheme_id = section.settings.color_scheme | default: 'scheme-landing'
  assign selected_scheme = settings.color_schemes[section_scheme_id]
  assign hero_bg_desktop = section.settings.background_image
  assign hero_bg_mobile = section.settings.background_image_mobile | default: hero_bg_desktop
  assign hero_overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_rgb = '0, 0, 0'

  if selected_scheme != blank
    assign scheme_bg_brightness = selected_scheme.settings.background | color_brightness
    if scheme_bg_brightness > 128
      assign overlay_rgb = '255, 255, 255'
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #MainProductV2-{{ section.id }} .main-product-v2__hero {
    background-color: var(--landing-section-bg);
    {%- if hero_bg_mobile != blank -%}
      background-image: linear-gradient(
          rgba({{ overlay_rgb }}, {{ hero_overlay }}),
          rgba({{ overlay_rgb }}, {{ hero_overlay }})
        ),
        url('{{ hero_bg_mobile | image_url: width: 1200 }}');
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #MainProductV2-{{ section.id }} .main-product-v2__hero {
      {%- if hero_bg_desktop != blank -%}
        background-image: linear-gradient(
            rgba({{ overlay_rgb }}, {{ hero_overlay }}),
            rgba({{ overlay_rgb }}, {{ hero_overlay }})
          ),
          url('{{ hero_bg_desktop | image_url: width: 2400 }}');
      {%- elsif hero_bg_mobile != blank -%}
        background-image: linear-gradient(
            rgba({{ overlay_rgb }}, {{ hero_overlay }}),
            rgba({{ overlay_rgb }}, {{ hero_overlay }})
          ),
          url('{{ hero_bg_mobile | image_url: width: 2400 }}');
      {%- endif -%}
    }
  }
{%- endstyle -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

<product-info
  id="MainProductV2-{{ section.id }}"
  class="main-product-v2 landing-page color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <div class="main-product-v2__hero">
    <div class="page-width main-product-v2__grid">
      <div class="main-product-v2__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="landing-page__eyebrow" data-aos="fade-up">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="landing-page__heading main-product-v2__title" data-aos="fade-up" data-aos-delay="100">
          {%- if section.settings.custom_title != blank -%}
            {{ section.settings.custom_title }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="main-product-v2__subtitle" data-aos="fade-up" data-aos-delay="200">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="main-product-v2__features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li class="main-product-v2__feature" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 | plus: 300 }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="main-product-v2__feature-icon">
                      {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.label }}
                    </span>
                  {%- else -%}
                    <span class="main-product-v2__feature-icon main-product-v2__feature-icon--default">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                    </span>
                  {%- endif -%}
                  <span class="main-product-v2__feature-label">{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="main-product-v2__card-wrapper" data-aos="fade-left" data-aos-delay="200">
        <div class="main-product-v2__card">
          {%- if section.settings.card_badge != blank -%}
            <span class="landing-page__badge main-product-v2__card-badge">{{ section.settings.card_badge }}</span>
          {%- endif -%}

          <h2 class="main-product-v2__card-title">{{ section.settings.card_title }}</h2>

          <div class="main-product-v2__price-row">
            {%- if section.settings.deposit_amount != blank -%}
              <span class="main-product-v2__deposit">{{ section.settings.deposit_amount }}</span>
            {%- else -%}
              <div class="main-product-v2__deposit">
                {% render 'price', product: product, use_variant: true, show_badges: false %}
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.savings_text != blank -%}
            <span class="landing-page__badge landing-page__badge--save main-product-v2__savings">{{ section.settings.savings_text }}</span>
          {%- endif -%}

          {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
          {%- if benefit_blocks.size > 0 -%}
            <ul class="main-product-v2__benefits">
              {%- for block in benefit_blocks -%}
                <li class="main-product-v2__benefit" {{ block.shopify_attributes }}>
                  <span class="main-product-v2__benefit-icon">
                    {%- if block.settings.icon != blank -%}
                      {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.title }}
                    {%- else -%}
                      <span class="main-product-v2__benefit-icon-fallback">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                      </span>
                    {%- endif -%}
                  </span>
                  <div class="main-product-v2__benefit-text">
                    {%- if block.settings.title != blank -%}
                      <p class="main-product-v2__benefit-title">{{ block.settings.title }}</p>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <p class="main-product-v2__benefit-subtitle">{{ block.settings.subtitle }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- assign product_form_id = 'product-form-v2-' | append: section.id -%}
          {%- render 'buy-buttons',
            product: product,
            product_form_id: product_form_id,
            section_id: section.id,
            show_pickup_availability: false,
            dynamic_checkout: section.settings.show_dynamic_checkout,
            button_label: section.settings.button_label,
            button_class: 'landing-page__btn-primary main-product-v2__submit button--full-width',
            wrapper_class: 'main-product-v2__form'
          -%}
        </div>
      </div>
    </div>
  </div>
</product-info>

{% schema %}
{
  "name": "Main Product V2",
  "tag": "section",
  "class": "section-main-product-v2",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Portable & Foldable"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Get early access, save big"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Pay a $50 deposit for first access to exclusive Kickstarter pricing and up to $2100 in savings."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-landing"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Uses desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%",
      "label": "Image overlay opacity"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tagline (above title)",
      "default": "Train Smarter. Shoot More. Get Better."
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Title",
      "info": "Leave blank to use product title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (below title)",
      "default": "Reserve Yours Today"
    },
    {
      "type": "header",
      "content": "Purchase card"
    },
    {
      "type": "text",
      "id": "card_badge",
      "label": "Card badge",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "Reserve with a Deposit"
    },
    {
      "type": "text",
      "id": "deposit_amount",
      "label": "Deposit amount display",
      "default": "$xx",
      "info": "Leave blank to use product price"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Savings badge",
      "default": "SAVE UP TO $xx"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Pay $50 Deposit"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Main Product V2",
      "blocks": [
        { "type": "feature", "settings": { "label": "Portable & Foldable" } },
        { "type": "feature", "settings": { "label": "App Controlled" } },
        { "type": "feature", "settings": { "label": "Elite Level Training" } },
        { "type": "benefit", "settings": { "title": "Get early access, save big", "subtitle": "Pay a $50 deposit for first access to exclusive Kickstarter pricing and up to $2100 in savings." } },
        { "type": "benefit", "settings": { "title": "Get cash back when campaign ends", "subtitle": "Receive cashback once our Kickstarter campaign concludes—applied to your Kickstarter pledge." } },
        { "type": "benefit", "settings": { "title": "Unlock early backer perks", "subtitle": "Gain priority shipping, insider updates, and access to our early-access community." } },
        { "type": "benefit", "settings": { "title": "No risk, no commitment", "subtitle": "Cancel anytime. Your $50 is safe." } },
        { "type": "benefit", "settings": { "title": "Not a full purchase", "subtitle": "This is a reservation, not a product order. No physical item will be shipped from this page." } }
      ]
    }
  ]
}
{% endschema %}
