{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-tabs.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors', section: section %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="landing-labels landing-page color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" id="landing-labels-{{ section.id }}">
  <div class="page-width">
    <ul class="landing-labels__list">
      {%- for block in section.blocks -%}
        <li
          class="landing-labels__item"
          data-aos="fade-up"
          data-aos-delay="{{ forloop.index0 | times: 100 }}"
          {{ block.shopify_attributes }}
        >
          <span class="landing-labels__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'athlete' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="7" r="3.5"/>
                  <path d="M6 20v-1.5a6 6 0 0 1 12 0V20"/>
                  <path d="M12 11.5l1.2 2.4 2.6.4-1.9 1.8.4 2.6L12 17.2l-2.3 1.5.4-2.6-1.9-1.8 2.6-.4z"/>
                </svg>
              {%- when 'training' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="9" width="3" height="6" rx="1"/>
                  <rect x="19" y="9" width="3" height="6" rx="1"/>
                  <path d="M5 12h14"/>
                  <rect x="7" y="10" width="2" height="4" rx="0.5"/>
                  <rect x="15" y="10" width="2" height="4" rx="0.5"/>
                </svg>
              {%- when 'portability' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6.5 10 3.5l7 3v11.5l-7 3-7-3V6.5z"/>
                  <circle cx="10" cy="10" r="1.25"/>
                  <circle cx="14.5" cy="14" r="1.25"/>
                  <path d="M10 10.5 14 14"/>
                </svg>
              {%- when 'innovation' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.5 19 6v5.5c0 4.8-3.2 8.2-7 9.5-3.8-1.3-7-4.7-7-9.5V6l7-3.5z"/>
                  <path d="M12 8.5 13.2 11l2.8.4-2 2 .5 2.8L12 15l-2.5 1.2.5-2.8-2-2 2.8-.4z"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/>
                </svg>
            {%- endcase -%}
          </span>
          <span class="landing-labels__text">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Feature Labels",
  "tag": "section",
  "class": "section-tabs",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "tab",
      "name": "Label",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trusted by Athletes"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "athlete", "label": "Athlete" },
            { "value": "training", "label": "Training" },
            { "value": "portability", "label": "Portability" },
            { "value": "innovation", "label": "Innovation" }
          ],
          "default": "athlete"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-landing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Feature Labels",
      "blocks": [
        { "type": "tab", "settings": { "label": "Trusted by Athletes", "icon": "athlete" } },
        { "type": "tab", "settings": { "label": "Built for Serious Training", "icon": "training" } },
        { "type": "tab", "settings": { "label": "Designed for Portability", "icon": "portability" } },
        { "type": "tab", "settings": { "label": "Backed by Innovation", "icon": "innovation" } }
      ]
    }
  ]
}
{% endschema %}
