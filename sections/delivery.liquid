{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-delivery.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors', section: section %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="delivery landing-page color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" id="delivery">
  <div class="page-width">
    <div class="delivery__header" data-aos="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="landing-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="landing-page__heading delivery__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="landing-page__subheading delivery__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="delivery__steps">
      {%- for block in section.blocks -%}
        <div class="delivery__step" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 150 }}" {{ block.shopify_attributes }}>
          <div class="landing-page__step-number">{{ forloop.index }}</div>
          {%- if block.settings.title != blank -%}
            <h3 class="delivery__step-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="delivery__step-text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            <div class="delivery__step-icon">
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag:
                  widths: '96, 144, 200',
                  sizes: '4.8rem',
                  alt: '',
                  class: 'delivery__step-icon__image',
                  loading: 'lazy'
              }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Delivery",
  "tag": "section",
  "class": "section-delivery",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pay $50 Deposit Now"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Secure your spot with a small refundable deposit."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-landing"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From deposit to delivery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reserve now, back on Kickstarter, get cashback after campaign ends."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Delivery",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pay $50 Deposit Now",
            "text": "Reserve your eligibility for additional savings with a $50 refundable deposit."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Enjoy Exclusive Pricing on Kickstarter",
            "text": "Secure your LUMISTAR CARRY through the Kickstarter campaign by using the same email address you used for your deposit. Limited offers available on early, first-come, first-served basis."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Get Cash Back After Campaign Ends",
            "text": "Upon the conclusion of the campaign and following the Kickstarter charge, you will receive cashback covering both your deposit and the bonus price difference."
          }
        }
      ]
    }
  ]
}
{% endschema %}
