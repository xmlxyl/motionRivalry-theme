{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-delivery.css' | asset_url | stylesheet_tag }}

{% render 'landing-page-colors' %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="delivery landing-page section-{{ section.id }}-padding" id="delivery">
  <div class="page-width">
    <div class="delivery__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="landing-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="landing-page__heading delivery__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="landing-page__subheading delivery__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="delivery__steps">
      {%- for block in section.blocks -%}
        <div class="delivery__step" {{ block.shopify_attributes }}>
          <div class="landing-page__step-number">{{ forloop.index }}</div>
          {%- if block.settings.title != blank -%}
            <h3 class="delivery__step-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="delivery__step-text">{{ block.settings.text }}</p>
          {%- endif -%}
          <div class="landing-page__icon-circle">
            {%- case block.settings.icon -%}
              {%- when 'card' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" stroke-width="1.5"/><path d="M2 10h20" stroke-width="1.5"/></svg>
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke-width="1.5"/><circle cx="7" cy="7" r="1.5" fill="currentColor" stroke="none"/></svg>
              {%- when 'dollar' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="1.5"/><path d="M12 7v10M9 9.5c0-1 1.5-1.5 3-1.5s3 .5 3 1.5-1.5 1.5-3 2-3 1-3 2 1.5 1.5 3 1.5 3-1.5" stroke-width="1.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="1.5"/></svg>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Delivery",
  "tag": "section",
  "class": "section-delivery",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pay $50 Deposit Now"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Secure your spot with a small refundable deposit."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "card", "label": "Credit card" },
            { "value": "tag", "label": "Price tag" },
            { "value": "dollar", "label": "Dollar sign" }
          ],
          "default": "card"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From deposit to delivery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reserve now, back on Kickstarter, get cashback after campaign ends."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Delivery",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pay $50 Deposit Now",
            "text": "Secure your spot with a small refundable deposit on our store.",
            "icon": "card"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Back on Kickstarter",
            "text": "When the campaign launches, complete your pledge to lock in early-bird pricing.",
            "icon": "tag"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Get Cashback After Campaign",
            "text": "Receive your deposit back plus exclusive savings when the campaign ends.",
            "icon": "dollar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
