{{ 'reach-reservation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reach-faq.js' | asset_url }}" defer="defer"></script>
{% render 'reach-fonts' %}
{% render 'reach-padding', section: section %}

<section id="support" class="reach-page reach-page__section section-{{ section.id }}-padding">
  {% render 'reach-side-tag', text: section.settings.side_tag, side: 'left' %}

  <div class="reach-page__inner reach-page__inner--narrow reach-faq">
    <p class="reach-page__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="reach-page__heading reach-faq__heading">{{ section.settings.heading }}</h2>

    <reach-faq-list class="reach-faq__list">
      {%- for block in section.blocks -%}
        <details class="reach-faq__item" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="reach-faq__question">
            <span class="reach-faq__question-label">
              <span class="reach-faq__num">0{{ forloop.index }}</span>
              {{ block.settings.question }}
            </span>
            <span class="reach-faq__toggle" aria-hidden="true">
              <svg class="reach-faq__icon-plus" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5"/></svg>
              <svg class="reach-faq__icon-minus" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
          </summary>
          <div class="reach-faq__answer">
            <div class="reach-faq__answer-inner">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </reach-faq-list>
  </div>
</section>

{% schema %}
{
  "name": "REACH FAQ",
  "tag": "section",
  "class": "section-reach-faq",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "side_tag", "label": "Side tag", "default": "[ A tech company in sports ]" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "[ FAQ ]" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [
    {
      "name": "REACH FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Can I place multiple deposits for different units?", "answer": "Yes. Each $5 deposit secures VIP pricing for one REACH. If you'd like to reserve more than one, simply place multiple deposits using the same email address." } },
        { "type": "question", "settings": { "question": "What is the deposit for?", "answer": "Your deposit unlocks exclusive VIP pricing, priority free shipping, and early-backer rewards. It also helps us plan production more accurately based on real demand." } },
        { "type": "question", "settings": { "question": "Is the deposit refundable?", "answer": "Absolutely. If you change your mind, just contact us at hello@motion-rivalry.com and we'll issue a full refund — no questions asked." } },
        { "type": "question", "settings": { "question": "How will the deposit be applied during the Kickstarter campaign?", "answer": "After you complete your Kickstarter pledge using the same email as your deposit, we'll issue a partial refund once the campaign ends. This refund includes your deposit amount plus your extra VIP savings within 14 business days after the campaign ends." } },
        { "type": "question", "settings": { "question": "Will I be notified when the Kickstarter campaign launches?", "answer": "Yes. You'll receive email reminders a few days before and on the day the campaign launches, so you won't miss your early access window." } },
        { "type": "question", "settings": { "question": "What if I use a different email on Kickstarter?", "answer": "The email you use for your Kickstarter pledge must match the one you used for your deposit to ensure your discount and refund are correctly applied. If you need to update your email, contact us with your deposit confirmation and we'll assist you." } }
      ]
    }
  ]
}
{% endschema %}
