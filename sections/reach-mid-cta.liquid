{{ 'reach-reservation.css' | asset_url | stylesheet_tag }}
{% render 'reach-fonts' %}
{% render 'reach-padding', section: section %}

<section class="reach-page reach-page__section section-{{ section.id }}-padding">
  <div class="reach-page__inner" style="padding-top:5rem;padding-bottom:5rem;">
    <div class="reach-mid-cta">
      <div class="reach-mid-cta__grid reach-grid-12">
        <div class="reach-col-7 reach-mid-cta__content">
          <div class="reach-mid-cta__tags">
            <span class="reach-page__badge">{{ section.settings.badge_pay }}</span>
            <span class="reach-mid-cta__accent">{{ section.settings.badge_save }}</span>
          </div>
          <h2 class="reach-page__heading reach-mid-cta__heading">{{ section.settings.heading }}</h2>
          <p class="reach-page__text reach-mid-cta__description">{{ section.settings.description }}</p>

          <div class="reach-mid-cta__tiers">
            <div class="reach-mid-cta__tier">
              <p class="reach-mid-cta__tier-label">{{ section.settings.early_bird_label }}</p>
              <div class="reach-mid-cta__tier-prices">
                <span class="reach-price reach-price--md">{{ section.settings.early_bird_price }}</span>
                <span class="reach-mid-cta__msrp">{{ section.settings.early_bird_msrp }}</span>
              </div>
            </div>
            <div class="reach-mid-cta__tier reach-mid-cta__tier--vip">
              <p class="reach-mid-cta__tier-label reach-mid-cta__tier-label--brand">{{ section.settings.vip_label }}</p>
              <div class="reach-mid-cta__tier-prices">
                <span class="reach-price reach-price--md reach-price--brand">{{ section.settings.vip_price }}</span>
                <span class="reach-mid-cta__save">{{ section.settings.vip_save }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reach-col-5 reach-mid-cta__aside">
          {% render 'reach-media', image: section.settings.image, label: section.settings.image_label, ratio: 'square', contain: true %}
          {% render 'reach-cta', url: section.settings.cta_url, label: section.settings.cta_label, class: 'reach-cta--full reach-mid-cta__button' %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REACH Mid Deposit CTA",
  "tag": "section",
  "class": "section-reach-mid-cta",
  "settings": [
    { "type": "text", "id": "badge_pay", "label": "Pay badge", "default": "Pay $5" },
    { "type": "text", "id": "badge_save", "label": "Save badge", "default": "Save 45% off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lock in your exclusive offer today." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Reserve your spot with a $5 deposit and secure VIP pricing — available only before the Kickstarter launch." },
    { "type": "header", "content": "Early Bird tier" },
    { "type": "text", "id": "early_bird_label", "label": "Label", "default": "Early Bird" },
    { "type": "text", "id": "early_bird_price", "label": "Price", "default": "$359" },
    { "type": "text", "id": "early_bird_msrp", "label": "MSRP", "default": "MSRP $599" },
    { "type": "header", "content": "VIP tier" },
    { "type": "text", "id": "vip_label", "label": "Label", "default": "VIP Only" },
    { "type": "text", "id": "vip_price", "label": "Price", "default": "$334" },
    { "type": "text", "id": "vip_save", "label": "Save badge", "default": "Save 45% Off" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Image label", "default": "REACH device" },
    { "type": "text", "id": "cta_url", "label": "CTA URL", "default": "/products/motion-rivalry-insight-stroke-gauge" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Pay $5 Deposit" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [{ "name": "REACH Mid Deposit CTA" }]
}
{% endschema %}
