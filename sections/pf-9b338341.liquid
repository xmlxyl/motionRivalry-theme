/**
 * 根据 URL Query 参数 'use' 自动选择所有带有 '.use-tabs' 类名的 Tabs 组件中的对应标签页。
 * 激活方式：强制设置 Radio 状态并触发 Change 事件。
 */
function activateTabsFromUrlQuery() {
  // 1. 获取 URL 中的查询参数
  const urlParams = new URLSearchParams(window.location.search);
  const useParam = urlParams.get("use");

  if (!useParam) {
    return;
  }

  // 定义参数值与 Tab 索引的映射关系 (已移除 'kayaking')
  const tabMapping = {
    cycling: 0, // 对应 Index 0
    rowing: 1, // 对应 Index 1
    paragliding: 2, // 对应 Index 2
  };

  const tabIndex = tabMapping[useParam.toLowerCase()];

  if (tabIndex === undefined) {
    return;
  }

  // 2. 查找页面上所有带有 '.use-tabs' 类名的 Tab 容器
  const tabContainers = document.querySelectorAll(".use-tabs");

  if (tabContainers.length === 0) {
    console.warn("No Tab containers with class 'use-tabs' found on the page.");
    return;
  }

  // 3. 遍历所有找到的 Tabs 容器并进行激活
  tabContainers.forEach((tabContainer) => {
    // 动态获取 Radio 按钮的 ID 前缀的唯一部分
    const radioNamePart = tabContainer.getAttribute("data-radio-name");

    if (!radioNamePart) {
      console.warn(
        "One of the .use-tabs containers is missing the 'data-radio-name' attribute. Skipping this container."
      );
      return;
    }

    const idPrefix = `pf-tab-${radioNamePart}`;
    const fullTabId = `${idPrefix}-${tabIndex}`;

    // 查找对应的隐藏 Radio Input 元素
    const targetRadio = tabContainer.querySelector(`#${fullTabId}`);

    if (targetRadio && targetRadio.type === "radio") {
      // I. 强制设置 Radio Input 为选中状态
      targetRadio.checked = true;

      // II. 触发 'change' 事件，通知可能监听此状态变化的 PageFly/主题脚本
      const changeEvent = new Event("change", { bubbles: true });
      targetRadio.dispatchEvent(changeEvent);

      // III. 手动更新 Tab Header 的样式属性 (data-pf-tab-active) 和移动端文本
      const allHeaders = tabContainer.querySelectorAll('label[data-pf-type="TabHeader3"]');

      allHeaders.forEach((header) => {
        const isTarget = header.getAttribute("for") === fullTabId;

        // 设置 data-pf-tab-active 属性来更新选中 Tab 的样式
        header.setAttribute("data-pf-tab-active", isTarget ? "true" : "false");

        // 如果存在移动端下拉菜单，也需要更新其文本
        if (isTarget) {
          const dropdownTextElement = tabContainer.querySelector(".pf-tab-dropdown-text");
          if (dropdownTextElement) {
            // 使用 trim() 清除可能存在的空格
            dropdownTextElement.textContent = header.textContent.trim();
          }
        }
      });
    } else {
      console.warn(`Radio Input with ID ${fullTabId} not found within container.`);
    }
  });

}

document.addEventListener("DOMContentLoaded", activateTabsFromUrlQuery);</script>
