<script>
  // ------------------------------------
      // 模块 3 滚动动画逻辑
      // ------------------------------------
      const module3 = document.getElementById("module3");
      const stackWrapper = document.getElementById("module-stack-wrapper");
      const stackBox = document.getElementById("module-stack-box");
      const phoneBodyImage = document.getElementById("phone-body-image");
      const phoneWhiteBgc = document.getElementById("phone-white-bgc");
      const phoneBlackBgc = document.getElementById("phone-black-bgc");

      let phoneImageURL = "https://cdn.shopify.com/s/files/1/0616/4447/2397/files/";
      let phoneImagePathSuffix = "";

      const gapSize = 25; // 阶段一移动距离：初始间距 (20px)
      const module2Height = 10; // 阶段二移动距离：模块二的高度 (10px)

      // 阶段一: 消除间隙 (50px)
      const scrollRange1 = 40;
      const startScroll1 = 0;

      // 阶段二: 遮盖模块二 (50px)
      const scrollRange2 = 40;
      const startScroll2 = startScroll1 + scrollRange1; // 动画在 ScrollY=150 处开始

      function handleScroll() {
        const currentScrollY = window.scrollY;
        let totalTranslate = 0;

        // --- 阶段一: 消除间隙 (0 to 150 scrollY) ---
        if (currentScrollY >= startScroll1) {
          // 计算阶段一的滚动进度 (0 到 1)
          let progress1 = (currentScrollY - startScroll1) / scrollRange1;
          progress1 = Math.min(1, Math.max(0, progress1)); // 限制在 [0, 1]

          // 阶段一的累计位移 (最多 50px)
          totalTranslate += progress1 * gapSize;
        }

        // --- 阶段二: 遮盖模块二 (150 to 350 scrollY) ---
        if (currentScrollY >= startScroll2) {
          // 计算阶段二的滚动进度 (0 到 1)
          let progress2 = (currentScrollY - startScroll2) / scrollRange2;
          progress2 = Math.min(1, Math.max(0, progress2)); // 限制在 [0, 1]

          // 阶段二的累计位移 (最多 50px)
          totalTranslate += progress2 * module2Height;
        }

        // 总的向上平移距离 (必须为负值)
        const translateValue = -(totalTranslate + 1);

        // 应用 transform 属性实现平滑上移
        module3.style.transform = `translateY(${translateValue}px)`;
      }

      // ------------------------------------
      // 模块 1 图片轮播逻辑 (由 5 个按钮控制) - 改进为只切换类名
      // ------------------------------------
      const carousel = document.getElementById("module1-carousel");
      const phoneControlButtons = document.getElementById("phone-node-control-buttons");

      // 图片 URL 列表 (5个,对应 5个按钮的 data-node-index 0-4)
      // 根据 phoneImagePathSuffix 动态生成图片路径
      function getImages() {
        return [
          `${phoneImageURL}phone_hero_cap_0${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_cam${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_walkie_0${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_wind${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_radar_0${phoneImagePathSuffix}.png`,
        ];
      }

      function getBase() {
        return [
          `${phoneImageURL}phone_hero_mid${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_mid${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_walkie_1${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_mid${phoneImagePathSuffix}.png`,
          `${phoneImageURL}phone_hero_radar_1${phoneImagePathSuffix}.png`,
        ];
      }

      let currentImageIndex = 0;
      function phoneChangeWhiteBgc() {
        phoneWhiteBgc.classList.add("phone-active-white-bgc");
        phoneBlackBgc.classList.remove("phone-active-black-bgc");
        stackBox.classList.remove("black");
        stackBox.classList.add("white");
        phoneImagePathSuffix = "";
        phoneBodyImage.src = `${phoneImageURL}phone_hero_body.png`;

        // 更新所有图片到浅色版本
        updateAllImages();
      }

      function phoneChangeBlackBgc() {
        phoneBlackBgc.classList.add("phone-active-black-bgc");
        phoneWhiteBgc.classList.remove("phone-active-white-bgc");
        stackBox.classList.remove("white");
        stackBox.classList.add("black");
        phoneImagePathSuffix = "_black";
        phoneBodyImage.src = `${phoneImageURL}phone_hero_body${phoneImagePathSuffix}.png`;

        // 更新所有图片到深色版本
        updateAllImages();
      }

      /**
       * 更新所有图片容器的 src 到当前颜色主题
       */
      function updateAllImages() {
        const images = getImages();
        const base = getBase();
        const imageContainers = carousel.querySelectorAll(".module-image-container");

        imageContainers.forEach((container, index) => {
          const img = container.querySelector("img");
          if (img && images[index]) {
            img.src = images[index];
          }
        });

        // 更新 module2 的图片
        const module2 = document.getElementById("module2");
        if (module2 && base[currentImageIndex]) {
          const module2Img = module2.querySelector("img");
          if (module2Img) {
            module2Img.src = base[currentImageIndex];
          }
        }
      }

      /**
       * 初始化轮播图的 DOM 结构,预先创建所有图片容器。
       * 只在页面加载时执行一次,提高切换性能。
       */
      function initializeCarousel() {
        const images = getImages();
        images.forEach((src, index) => {
          const imgContainer = document.createElement("div");
          // 使用 CSS 类实现绝对定位和过渡效果
          imgContainer.className = "module-image-container";

          // 给容器添加索引,方便 renderImage 找到它们
          imgContainer.setAttribute("data-index", index);

          const img = document.createElement("img");
          img.src = src;
          img.alt = `模块一图片 ${index + 1}`;
          img.className = "module-image"; // 保持样式类
          img.style.position = "absolute";
          img.style.bottom = "0";
          // img.style.left = '0';

          imgContainer.appendChild(img);
          carousel.appendChild(imgContainer);
        });
      }
      /**
       * 渲染指定索引的图片,通过切换类名实现淡入淡出效果 (更高效)。
       * @param {number} newIndex - 要切换到的新图片索引。
       */
      function renderImage(newIndex = currentImageIndex) {
        currentImageIndex = newIndex;

        // 获取所有预创建的图片容器
        const imageContainers = carousel.querySelectorAll(".module-image-container");
        const images = getImages();

        imageContainers.forEach((container, index) => {
          if (index === currentImageIndex) {
            container.classList.add("active"); // 激活当前图片,触发淡入
          } else {
            container.classList.remove("active"); // 隐藏其他图片,触发淡出
          }
        });

        if (carousel.childNodes[1]) {
          carousel.childNodes[1].src = images[currentImageIndex];
        }

        // 更新按钮图标状态
        updateButtonState(currentImageIndex);
      }

      /**
       * 更新控制按钮的视觉状态，例如高亮当前激活的按钮。
       * @param {number} activeIndex - 当前激活的图片索引。
       */
      function updateButtonState(activeIndex) {
        const buttons = phoneControlButtons.querySelectorAll("button");
        buttons.forEach((button, index) => {
          // 切换按钮的 'active' 类以改变背景和阴影样式 (CSS .phone-controls-wrapper button.active)
          if (index === activeIndex) {
            button.classList.add("active");
          } else {
            button.classList.remove("active");
          }
        });
      }

      // 处理按钮点击事件:根据 data-node-index 切换图片
      phoneControlButtons.addEventListener("click", (e) => {
        const button = e.target.closest("button");
        const module2 = document.getElementById("module2");
        if (button) {
          const index = parseInt(button.getAttribute("data-node-index"));
          if (!isNaN(index)) {
            renderImage(index);
            const base = getBase();
            const module2Img = module2.querySelector("img");
            if (module2Img && base[index]) {
              module2Img.src = base[index];
            }
          }
        }
      });

      // 绑定事件
      window.addEventListener("scroll", handleScroll);

      // 页面加载和调整大小事件处理 (更新加载顺序)
      window.addEventListener("load", () => {
        // initializeCarousel(); // 1. 首次加载时创建所有图片 DOM
        renderImage(0); // 2. 激活 Index 0 的图片

        // 延迟执行以确保所有样式和布局已完成
        setTimeout(() => {
          handleScroll();
        }, 100);
      });

      window.addEventListener("resize", () => {
        handleScroll();
      });

      // 首次执行 (确保滚动位置在 DOM 就绪后被计算)
      handleScroll();
