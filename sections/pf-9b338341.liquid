<script>
  const imageElement = document.getElementById("animation-image");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const nodeControlButtonsContainer = document.getElementById("node-control-buttons");
      const nodeDisplay = document.getElementById("current-node-display");
      const frameDisplay = document.getElementById("current-frame-display");
      const soundEffect = document.getElementById("node-sound-effect");

      const whiteBgc = document.getElementById("white-bgc");
      const blackBgc = document.getElementById("black-bgc");
      const lpTextImage = document.getElementById("lp-text-image");
      const priceImage = document.getElementById("price-image");
      const fullPageContainer = document.querySelector(".full-page-container");

      // 初始化

      // --- 配置 ---
      let imageURL = "https://cdn.shopify.com/s/files/1/0616/4447/2397/files/";
      let imagePathPrefix = "white_";

      const INITIAL_START_FRAME = 0;
      const INITIAL_END_FRAME = 51;

      // 关键帧数组
      const newKeyFrames = [51, 90, 129, 168, 207];

      const totalFrames = 208; // 0000.jpg 到 0207.jpg
      const FRAME_INTERVAL = 40;
      const TRANSITION_FRAMES = 14; // 关键：前后 14 帧过渡区

      let currentNodeIndex = 0;
      let currentFrame = 0;
      let animationInterval = null;

      let animationSourceIndex = -1;
      let animationTargetIndex = -1;
      let isInitialLoadAnimation = false;

      let immageIndex = 0;

      let imageCache = {};
      let imagesLoaded = false;
      let isDesktop = false;

      // 检查是否为桌面尺寸
      function checkScreenSize() {
        return window.innerWidth >= 768;
      }

      // ------------------- 预加载所有帧 -------------------
      function preloadImages(onComplete) {
        if (imagesLoaded) {
          if (onComplete) onComplete();
          return;
        }

        let loaded = 0;
        const prefixes = ["white_", "black_"];
        const totalImages = totalFrames * prefixes.length;

        prefixes.forEach((prefix) => {
          for (let i = 0; i < totalFrames; i++) {
            const frameNumber = String(i).padStart(4, "0");
            const img = new Image();
            img.src = `${imageURL}${prefix}${frameNumber}.jpg`;
            img.onload = img.onerror = () => {
              if (!imageCache[prefix]) {
                imageCache[prefix] = {};
              }
              imageCache[prefix][i] = img;
              loaded++;
              if (loaded === totalImages) {
                imagesLoaded = true;
                if (onComplete) onComplete();
              }
            };
          }
        });
      }

      function changeWhiteBgc() {
        whiteBgc.classList.add("active-white-bgc");
        blackBgc.classList.remove("active-black-bgc");
        fullPageContainer.classList.remove("black");
        fullPageContainer.classList.add("white");
        imagePathPrefix = "white_";
        imageElement.src = `${imageURL}${imagePathPrefix}${formatFrameNumber(immageIndex)}.jpg`;
        // lpTextImage.src = `${imageURL}white_text.png`;
        // priceImage.src = `${imageURL}white_price.png`;
      }

      function changeBlackBgc() {
        blackBgc.classList.add("active-black-bgc");
        whiteBgc.classList.remove("active-white-bgc");
        fullPageContainer.classList.remove("white");
        fullPageContainer.classList.add("black");
        imagePathPrefix = "black_";
        imageElement.src = `${imageURL}${imagePathPrefix}${formatFrameNumber(immageIndex)}.jpg`;
        // lpTextImage.src = `${imageURL}black_text.png`;
        // priceImage.src = `${imageURL}black_price.png`;
      }

      // --- 工具函数 (保持不变) ---
      function formatFrameNumber(frameIndex) {
        return String(frameIndex).padStart(4, "0");
      }

      function updateFrame(frameIndex) {
        frameIndex = Math.max(0, Math.min(frameIndex, totalFrames - 1));

        currentFrame = frameIndex;
        const frameNumber = formatFrameNumber(frameIndex);
        imageElement.src = `${imageURL}${imagePathPrefix}${frameNumber}.jpg`;
        frameDisplay.textContent = frameIndex;
        immageIndex = frameIndex;
      }

      function setButtonsDisabled(disabled) {
        const allButtons = document.querySelectorAll(".controls-wrapper button");
        whiteBgc.disabled = disabled;
        blackBgc.disabled = disabled;
        allButtons.forEach((btn) => {
          btn.disabled = disabled;
        });

        if (!disabled && currentNodeIndex === 0) {
          prevBtn.disabled = true;
        }
      }

      function updateActiveButton() {
        Array.from(nodeControlButtonsContainer.children).forEach((btn, index) => {
          if (index === currentNodeIndex) {
            btn.classList.add("active");
            nodeDisplay.textContent = newKeyFrames[currentNodeIndex];
          } else {
            btn.classList.remove("active");
          }
        });

        if (currentNodeIndex === 0) {
          prevBtn.disabled = true;
        } else {
          prevBtn.disabled = false;
        }

        if (currentNodeIndex === newKeyFrames.length - 1) {
          nextBtn.disabled = true;
        } else {
          nextBtn.disabled = false;
        }
      }

      function playSoundEffect() {
        soundEffect.currentTime = 0;
        soundEffect.play().catch((error) => {
          console.warn("Audio playback failed:", error);
        });
      }

      // --- 动画播放逻辑 (保持不变) ---
      function playAnimationSequence(startFrame, endFrame, direction, onComplete = () => {}) {
        if (animationInterval) {
          return;
        }

        setButtonsDisabled(true);

        let frame = startFrame;
        isInitialLoadAnimation = animationSourceIndex === -1 && animationTargetIndex === -1;

        if (startFrame === endFrame) {
          updateFrame(endFrame);
          setButtonsDisabled(false);
          if (!isInitialLoadAnimation) playSoundEffect();
          onComplete();

          animationSourceIndex = -1;
          animationTargetIndex = -1;
          return;
        }

        updateFrame(frame);

        const step = direction * 1;

        // 核心跳帧逻辑判断：非初始化动画 且 跨节点跳转
        const isJumpMode = !isInitialLoadAnimation && Math.abs(animationSourceIndex - animationTargetIndex) > 1;

        let intermediateNodes = [];
        if (isJumpMode) {
          const minIndex = Math.min(animationSourceIndex, animationTargetIndex);
          const maxIndex = Math.max(animationSourceIndex, animationTargetIndex);

          // 收集所有需要跳过过渡区的中间节点（不包含起点和终点）
          for (let i = minIndex + 1; i < maxIndex; i++) {
            intermediateNodes.push(newKeyFrames[i]);
          }
        }

        animationInterval = setInterval(() => {
          let nextFrame = frame + step;

          if (isJumpMode) {
            // 遍历所有中间节点关键帧
            for (const keyFrame of intermediateNodes) {
              // 定义该中间关键帧的过渡区
              const skipStartFrame = keyFrame - TRANSITION_FRAMES;
              const skipEndFrame = keyFrame + TRANSITION_FRAMES;

              if (direction > 0) {
                // 前进 (A -> B)
                // 如果下一帧进入了该中间节点的过滤区
                if (nextFrame >= skipStartFrame && nextFrame <= skipEndFrame) {
                  // 瞬移到过滤区终点后的下一帧
                  nextFrame = skipEndFrame + 1;
                  break;
                }
              } else {
                // 后退 (B -> A)
                // 如果下一帧进入了该中间节点的过滤区
                if (nextFrame <= skipEndFrame && nextFrame >= skipStartFrame) {
                  // 瞬移到过滤区起点前的下一帧
                  nextFrame = skipStartFrame - 1;
                  break;
                }
              }
            }
          }

          // 确保 nextFrame 不会越过 endFrame
          if (direction > 0 && nextFrame > endFrame) {
            nextFrame = endFrame;
          } else if (direction < 0 && nextFrame < endFrame) {
            nextFrame = endFrame;
          }

          frame = nextFrame;

          let isFinished = direction > 0 ? frame >= endFrame : frame <= endFrame;

          if (isFinished) {
            clearInterval(animationInterval);
            animationInterval = null;

            updateFrame(endFrame);

            if (!isInitialLoadAnimation) playSoundEffect();

            setButtonsDisabled(false);
            updateActiveButton();
            onComplete();

            animationSourceIndex = -1;
            animationTargetIndex = -1;

            return;
          }

          updateFrame(frame);
        }, FRAME_INTERVAL);
      }

      // --- 通用跳转逻辑 (保持不变) ---
      function goToNode(targetNodeIndex) {
        if (targetNodeIndex === currentNodeIndex || animationInterval) {
          return;
        }

        if (targetNodeIndex < 0 || targetNodeIndex >= newKeyFrames.length) {
          return;
        }

        const targetKeyFrame = newKeyFrames[targetNodeIndex];

        const direction = targetKeyFrame > currentFrame ? 1 : -1;

        const startFrame = currentFrame;

        // 预先保存目标索引
        animationSourceIndex = currentNodeIndex;
        animationTargetIndex = targetNodeIndex;
        currentNodeIndex = targetNodeIndex; // 立即更新 currentNodeIndex

        playAnimationSequence(startFrame, targetKeyFrame, direction);
      }

      // --- 线性切换逻辑 (保持不变) ---

      function nextKeyFrame() {
        if (currentNodeIndex >= newKeyFrames.length - 1) {
          return;
        }
        goToNode(currentNodeIndex + 1);
      }

      function prevKeyFrame() {
        if (currentNodeIndex <= 0) {
          return;
        }
        goToNode(currentNodeIndex - 1);
      }

      // --- 初始化和事件绑定 (修复 prevBtn 绑定) ---

      nextBtn.addEventListener("click", nextKeyFrame);
      // 关键修复：将 prevBtn 修正为 prevKeyFrame
      prevBtn.addEventListener("click", prevKeyFrame);

      nodeControlButtonsContainer.addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (button) {
          const targetIndex = parseInt(button.dataset.nodeIndex, 10);
          if (!isNaN(targetIndex)) {
            goToNode(targetIndex);
          }
        }
      });

      function initAnimation() {
        setButtonsDisabled(true);

        playAnimationSequence(INITIAL_START_FRAME, INITIAL_END_FRAME, 1, () => {
          currentNodeIndex = 0;
          updateActiveButton();
        });
      }

      // 页面加载即预加载所有帧（仅桌面端）
      function initApp() {
        isDesktop = checkScreenSize();

        if (isDesktop) {
          preloadImages(() => {
            console.log("所有帧预加载完成");
            initAnimation();
          });
        } else {
          console.log("移动端，跳过图片预加载");
          // 移动端不加载图片，可以显示占位符或提示
        }
      }

      // 监听窗口 resize 事件
      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const newIsDesktop = checkScreenSize();

          // 从移动端切换到桌面端
          if (!isDesktop && newIsDesktop) {
            isDesktop = true;
            console.log("切换到桌面端，开始加载图片");
            preloadImages(() => {
              console.log("所有帧预加载完成");
              initAnimation();
            });
          }
          // 从桌面端切换到移动端
          else if (isDesktop && !newIsDesktop) {
            isDesktop = false;
            console.log("切换到移动端");
            // 可以选择停止动画或清理资源
            if (animationInterval) {
              clearInterval(animationInterval);
              animationInterval = null;
            }
          }
        }, 250); // 防抖 250ms
      });

      // 初始化应用
      initApp();
</script></div></div></section><section data-section-id="pf-5ad5" data-pf-type="FlexSection" class="sc-cKXyOM gdMpOS pf-15_ pf-container-1 pf-color-scheme-1 pf-lg-hide pf-md-hide"><div class="sc-eBwJYS fUJvuc"></div><div class="sc-bHnkpz ffFBJG pf-flex-section"><div data-pf-type="Custom.HTML" class="sc-lbJdeI bvzyhN pf-16_"><!-- 引入 Tailwind CSS -->
