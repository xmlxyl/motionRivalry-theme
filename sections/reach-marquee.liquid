{{ 'reach-reservation.css' | asset_url | stylesheet_tag }}
{% render 'reach-fonts' %}
{% render 'reach-padding', section: section %}

<section class="reach-page reach-page__section reach-page__section--surface section-{{ section.id }}-padding" style="overflow:hidden;padding-top:1.5rem;padding-bottom:1.5rem;">
  <div class="reach-marquee__track">
    <div class="reach-marquee__row">
      {%- for block in section.blocks -%}
        <span class="reach-marquee__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <span class="reach-marquee__dot"></span>
        </span>
      {%- endfor -%}
    </div>
    <div class="reach-marquee__row" aria-hidden="true">
      {%- for block in section.blocks -%}
        <span class="reach-marquee__item">
          {{ block.settings.text }}
          <span class="reach-marquee__dot"></span>
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REACH Marquee",
  "tag": "section",
  "class": "section-reach-marquee",
  "blocks": [
    {
      "type": "item",
      "name": "Marquee item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "ONE DEVICE · EVERY SPORT" }
      ]
    }
  ],
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [
    {
      "name": "REACH Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "ONE DEVICE · EVERY SPORT" } },
        { "type": "item", "settings": { "text": "IPX7 WATERPROOF" } },
        { "type": "item", "settings": { "text": "10Hz GPS" } },
        { "type": "item", "settings": { "text": "MODULAR BY DESIGN" } },
        { "type": "item", "settings": { "text": "26-HOUR BATTERY" } }
      ]
    }
  ]
}
{% endschema %}
